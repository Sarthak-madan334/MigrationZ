POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=migration_rehearsal
POSTGRES_USER=rehearsal
POSTGRES_PASSWORD=rehearsal
# Set DATABASE_URL on Render to the internal URL for a dedicated shadow Postgres database.
DATABASE_URL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.35
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true on HTTPS hosting; this also enables SameSite=None for cross-origin OAuth/API requests.
GITHUB_SESSION_COOKIE_SECURE=false
GITHUB_SESSION_TTL_SECONDS=28800
